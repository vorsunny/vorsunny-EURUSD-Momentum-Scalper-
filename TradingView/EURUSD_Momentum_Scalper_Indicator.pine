//@version=6
indicator("EURUSD Momentum Scalper Indicator v1.1", shorttitle="EURUSD MomScalp", overlay=true, max_labels_count=50)

// Signals and alerting only. Pine indicators cannot submit broker orders or enforce account risk.
int tickWindow = input.int(30, "Rolling sample window", minval=2, maxval=512)
float momentumThresholdPips = input.float(1.5, "Momentum threshold (pips)", minval=0.1, step=0.1)
float stopLossPips = input.float(5.0, "Indicative stop distance (pips)", minval=0.1, step=0.1)
float takeProfitPips = input.float(7.5, "Indicative target distance (pips)", minval=0.1, step=0.1)
float maxSpreadPips = input.float(1.0, "Maximum assumed spread (pips); 0 disables", minval=0.0, step=0.1)
float assumedSpreadPips = input.float(1.0, "Assumed spread (pips)", minval=0.0, step=0.1)
int cooldownSeconds = input.int(30, "Minimum seconds between alerts", minval=0)
int maxSignalsPerDay = input.int(30, "Maximum signals per day", minval=1, maxval=500)
int minSamplesPerMinute = input.int(10, "Minimum samples in last minute", minval=0, maxval=512)
float maxWindowRangePips = input.float(8.0, "Maximum window range (pips); 0 disables", minval=0.0, step=0.1)
float maxSingleSampleJumpPips = input.float(5.0, "Maximum single-sample jump (pips); 0 disables", minval=0.0, step=0.1)
bool sessionFilterEnabled = input.bool(false, "Enable session filter")
int sessionStartHour = input.int(0, "Session start hour", minval=0, maxval=23)
int sessionStartMinute = input.int(0, "Session start minute", minval=0, maxval=59)
int sessionEndHour = input.int(23, "Session end hour", minval=0, maxval=23)
int sessionEndMinute = input.int(59, "Session end minute", minval=0, maxval=59)
string sessionTimezone = input.string("Etc/UTC", "Session and daily reset timezone (IANA)")
string samplingMode = input.string("Realtime updates", "Sampling mode", options=["Realtime updates", "Bar-close proxy"])
float pipSizeOverride = input.float(0.0, "Pip size override (0 = auto)", minval=0.0, step=0.00001)
bool requireEURUSD = input.bool(true, "Require EURUSD chart")

int CAPACITY = 512
// FX pip size is a quote-currency convention, not a function of feed precision.
// This handles fractional and non-fractional EURUSD quotes consistently.
float autoPip = syminfo.type == "forex" ? (syminfo.currency == "JPY" ? 0.01 : 0.0001) : (syminfo.mintick < 0.0001 ? syminfo.mintick * 10.0 : syminfo.mintick)
float pip = pipSizeOverride > 0.0 ? pipSizeOverride : autoPip
bool isEURUSD = syminfo.basecurrency == "EUR" and syminfo.currency == "USD"
bool symbolAllowed = not requireEURUSD or isEURUSD

// varip preserves the rolling samples and signal latch between realtime executions of a bar.
varip array<float> prices = array.new_float(CAPACITY, na)
varip array<int> sampleTimes = array.new_int(CAPACITY, na)
varip int nextSlot = 0
varip int sampleCount = 0
varip int latchedDirection = 0
varip int lastSignalTime = na
varip int activeDay = na
varip int signalsToday = 0
varip int seenBar = na
varip bool buyPulse = false
varip bool sellPulse = false
varip float latestStop = na
varip float latestTarget = na

if na(seenBar) or bar_index != seenBar
    seenBar := bar_index
    buyPulse := false
    sellPulse := false

bool useRealtimeTicks = samplingMode == "Realtime updates"
bool sampleNow = useRealtimeTicks ? barstate.isrealtime : barstate.isconfirmed
int sampleTime = barstate.isrealtime ? timenow : time_close
int hourNow = hour(sampleTime, sessionTimezone)
int minuteNow = minute(sampleTime, sessionTimezone)
int minuteOfDay = hourNow * 60 + minuteNow
int sessionStart = sessionStartHour * 60 + sessionStartMinute
int sessionEnd = sessionEndHour * 60 + sessionEndMinute
bool sessionAllowed = not sessionFilterEnabled or sessionStart == sessionEnd or (sessionStart < sessionEnd ? minuteOfDay >= sessionStart and minuteOfDay < sessionEnd : minuteOfDay >= sessionStart or minuteOfDay < sessionEnd)
bool spreadAllowed = maxSpreadPips <= 0.0 or assumedSpreadPips <= maxSpreadPips
float sampledPrice = close
bool validPrice = not na(sampledPrice) and sampledPrice > 0.0 and pip > 0.0
bool eligibleSample = sampleNow and symbolAllowed and validPrice and spreadAllowed and sessionAllowed

bool acceptedSample = false
if eligibleSample
    float previousPrice = na
    if sampleCount > 0
        int previousSlot = (nextSlot - 1 + CAPACITY) % CAPACITY
        previousPrice := array.get(prices, previousSlot)
    bool jumpAllowed = na(previousPrice) or maxSingleSampleJumpPips <= 0.0 or math.abs(sampledPrice - previousPrice) / pip <= maxSingleSampleJumpPips
    if jumpAllowed
        array.set(prices, nextSlot, sampledPrice)
        array.set(sampleTimes, nextSlot, sampleTime)
        nextSlot := (nextSlot + 1) % CAPACITY
        sampleCount := math.min(sampleCount + 1, CAPACITY)
        acceptedSample := true

float momentumPips = na
float windowRangePips = na
int activeSamples = 0
bool volatilityAllowed = false
bool activityAllowed = false

if acceptedSample and sampleCount >= tickWindow
    int oldestSlot = (nextSlot - tickWindow + CAPACITY) % CAPACITY
    momentumPips := (sampledPrice - array.get(prices, oldestSlot)) / pip
    float lowest = sampledPrice
    float highest = sampledPrice
    for offset = 0 to tickWindow - 1
        int slot = (nextSlot - 1 - offset + CAPACITY) % CAPACITY
        float value = array.get(prices, slot)
        lowest := math.min(lowest, value)
        highest := math.max(highest, value)
    windowRangePips := (highest - lowest) / pip
    volatilityAllowed := maxWindowRangePips <= 0.0 or windowRangePips <= maxWindowRangePips
    for offset = 0 to sampleCount - 1
        int slot = (nextSlot - 1 - offset + CAPACITY) % CAPACITY
        int stamp = array.get(sampleTimes, slot)
        if na(stamp) or sampleTime - stamp > 60000
            break
        activeSamples += 1
    activityAllowed := not useRealtimeTicks or activeSamples >= minSamplesPerMinute

int dayId = year(sampleTime, sessionTimezone) * 10000 + month(sampleTime, sessionTimezone) * 100 + dayofmonth(sampleTime, sessionTimezone)
if na(activeDay) or dayId != activeDay
    activeDay := dayId
    signalsToday := 0

int candidateDirection = 0
if not na(momentumPips) and volatilityAllowed and activityAllowed
    if math.abs(momentumPips) < momentumThresholdPips * 0.5
        latchedDirection := 0
    candidateDirection := momentumPips >= momentumThresholdPips ? 1 : momentumPips <= -momentumThresholdPips ? -1 : 0
    if candidateDirection == latchedDirection
        candidateDirection := 0

bool cooldownPassed = na(lastSignalTime) or sampleTime - lastSignalTime >= cooldownSeconds * 1000
bool dailyLimitPassed = signalsToday < maxSignalsPerDay
if candidateDirection != 0
    // Consume a threshold episode even if cooldown or daily signal cap blocks its alert.
    latchedDirection := candidateDirection
    if cooldownPassed and dailyLimitPassed
        buyPulse := candidateDirection == 1
        sellPulse := candidateDirection == -1
        lastSignalTime := sampleTime
        signalsToday += 1
        latestStop := sampledPrice - candidateDirection * stopLossPips * pip
        latestTarget := sampledPrice + candidateDirection * takeProfitPips * pip

plotshape(buyPulse, title="Momentum BUY", style=shape.labelup, location=location.belowbar, color=color.new(color.green, 0), text="BUY", textcolor=color.white, size=size.tiny)
plotshape(sellPulse, title="Momentum SELL", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0), text="SELL", textcolor=color.white, size=size.tiny)
plot(latestStop, title="Latest indicative stop", color=color.new(color.red, 15), linewidth=1, style=plot.style_linebr)
plot(latestTarget, title="Latest indicative target", color=color.new(color.green, 15), linewidth=1, style=plot.style_linebr)
plot(momentumPips, title="Momentum (pips)", color=color.new(color.blue, 100), display=display.data_window)

alertcondition(buyPulse, title="EURUSD Momentum BUY", message="EURUSD Momentum Scalper BUY signal. Confirm spread, execution, and risk manually.")
alertcondition(sellPulse, title="EURUSD Momentum SELL", message="EURUSD Momentum Scalper SELL signal. Confirm spread, execution, and risk manually.")

var table status = table.new(position.top_right, 2, 4, border_width=1)
if barstate.islast
    string modeText = useRealtimeTicks ? "Realtime updates" : "Bar-close proxy"
    string momentumText = na(momentumPips) ? "Warming / unavailable" : str.tostring(momentumPips, "#.###") + " pips"
    string filterText = not symbolAllowed ? "EURUSD required" : not spreadAllowed ? "Spread assumption blocked" : not sessionAllowed ? "Outside session" : sampleCount < tickWindow ? "Warming buffer" : not volatilityAllowed ? "Volatility blocked" : (useRealtimeTicks and not activityAllowed) ? "Activity below minimum" : "Ready"
    table.cell(status, 0, 0, "EURUSD Momentum", bgcolor=color.new(color.blue, 65), text_color=color.white)
    table.cell(status, 1, 0, modeText, bgcolor=color.new(color.blue, 65), text_color=color.white)
    table.cell(status, 0, 1, "Momentum", text_color=color.white)
    table.cell(status, 1, 1, momentumText, text_color=color.white)
    table.cell(status, 0, 2, "Spread assumption", text_color=color.white)
    table.cell(status, 1, 2, str.tostring(assumedSpreadPips, "#.##") + " pips", text_color=color.white)
    table.cell(status, 0, 3, "Status", text_color=color.white)
    table.cell(status, 1, 3, filterText, text_color=color.white)

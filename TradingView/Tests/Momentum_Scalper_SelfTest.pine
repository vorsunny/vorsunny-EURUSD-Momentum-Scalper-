//@version=6
indicator("Momentum Core Native Self-Test RC1", shorttitle="Mom Tests", overlay=true)
// Run in Pine Editor. Uses the same generated helper code as both release scripts.
// BEGIN SHARED MOMENTUM CORE
// Shared Pine v6 helpers. Synced into standalone scripts by Tools/build_tradingview.py.
ms_pip(bool eurusd, string instrumentType, string quoteCurrency, float tick, float overridePip) =>
    overridePip > 0 ? overridePip : eurusd ? 0.0001 : instrumentType == "forex" ? (quoteCurrency == "JPY" ? 0.01 : 0.0001) : tick

ms_session(int stamp, string zone, bool enabled, int startMinute, int endMinute) =>
    int minuteOfDay = hour(stamp, zone) * 60 + minute(stamp, zone)
    not enabled or startMinute == endMinute or (startMinute < endMinute ? minuteOfDay >= startMinute and minuteOfDay < endMinute : minuteOfDay >= startMinute or minuteOfDay < endMinute)

// Caller passes only valid eligible samples. Gap resets seed with this sample;
// a price jump is discarded and the next sample starts the new window.
ms_window(array<float> prices, array<int> stamps, int next, int count, float price, int stamp, int window, float pip, float gapLimitMs, float jumpLimitPips) =>
    int capacity = array.size(prices)
    int n = next
    int c = count
    int reset = 0
    if c > 0
        int newest = (n - 1 + capacity) % capacity
        int gap = stamp - array.get(stamps, newest)
        if gap < 0 or gap > gapLimitMs
            n := 0
            c := 0
            reset := 1
    bool jump = c > 0 and jumpLimitPips > 0 and math.abs(price - array.get(prices, (n - 1 + capacity) % capacity)) / pip > jumpLimitPips
    if jump
        n := 0
        c := 0
        reset := 2
    else
        array.set(prices, n, price)
        array.set(stamps, n, stamp)
        n := (n + 1) % capacity
        c := math.min(c + 1, capacity)
    float momentum = na
    float priceRange = na
    int active = 0
    if not jump
        for offset = 0 to c - 1
            if stamp - array.get(stamps, (n - 1 - offset + capacity) % capacity) > 60000
                break
            active += 1
        if c >= window
            // Remove floating subtraction noise at exact pip thresholds.
            momentum := math.round((price - array.get(prices, (n - window + capacity) % capacity)) / pip, 9)
            float low = price
            float high = price
            for offset = 0 to window - 1
                float value = array.get(prices, (n - 1 - offset + capacity) % capacity)
                low := math.min(low, value)
                high := math.max(high, value)
            priceRange := math.round((high - low) / pip, 9)
    [n, c, momentum, priceRange, active, reset]

// Consumes a threshold episode even when the caller's execution gates block it.
ms_episode(float momentum, float threshold, int latch, bool eligible) =>
    int nextLatch = latch
    int candidate = 0
    if eligible and not na(momentum)
        if math.abs(momentum) < threshold * 0.5
            nextLatch := 0
        int direction = momentum >= threshold ? 1 : momentum <= -threshold ? -1 : 0
        if direction != 0 and direction != nextLatch
            candidate := direction
            nextLatch := direction
    [nextLatch, candidate]

ms_cooldown(int stamp, int lastEvent, int seconds) =>
    na(lastEvent) ? 0 : int(math.max(0, math.ceil((lastEvent + seconds * 1000.0 - stamp) / 1000.0)))

ms_can_signal(int candidate, int stamp, int lastEvent, int seconds, int eventsToday, int cap) =>
    candidate != 0 and ms_cooldown(stamp, lastEvent, seconds) == 0 and eventsToday < cap

ms_ticks(float distancePips, float pip, float tick) =>
    int(math.max(1, math.round(distancePips * pip / tick)))

ms_quantity(float budget, float riskPerUnit, float step, float minimum, float maximum) =>
    float quantity = na
    if budget > 0 and riskPerUnit > 0 and step > 0 and maximum >= minimum
        quantity := math.floor(math.min(budget / riskPerUnit, maximum) / step) * step
    bool allowed = not na(quantity) and quantity >= minimum and quantity > 0
    [quantity, allowed]

ms_daily(bool newDay, float previousEquity, float equity, float initialCapital, float oldBaseline, bool oldLock, float limitPercent) =>
    float baseline = newDay ? nz(previousEquity, initialCapital) : oldBaseline
    float pnl = baseline > 0 ? (equity - baseline) / baseline * 100.0 : na
    bool locked = (newDay ? false : oldLock) or (limitPercent > 0 and not na(pnl) and pnl <= -limitPercent)
    [baseline, pnl, locked]
// END SHARED MOMENTUM CORE

ms_assert(bool condition, string name) =>
    if not condition
        runtime.error("FAIL: " + name)
    true

var table result = table.new(position.top_left, 1, 1)
if barstate.isfirst
    ms_assert(ms_pip(true, "cfd", "USD", 0.000001, 0) == 0.0001, "EURUSD CFD pip")
    ms_assert(ms_pip(true, "forex", "USD", 0.0001, 0) == 0.0001, "EURUSD nonfractional pip")
    ms_assert(ms_pip(false, "forex", "JPY", 0.001, 0) == 0.01, "JPY fractional pip")
    ms_assert(ms_pip(false, "forex", "JPY", 0.01, 0) == 0.01, "JPY pip")
    ms_assert(ms_pip(true, "forex", "USD", 0.00001, 0.001) == 0.001, "pip override")
    ms_assert(ms_session(timestamp("01 Jan 2026 23:00 +0000"), "Etc/UTC", true, 1320, 120), "overnight late")
    ms_assert(ms_session(timestamp("02 Jan 2026 01:00 +0000"), "Etc/UTC", true, 1320, 120), "overnight early")
    ms_assert(not ms_session(timestamp("02 Jan 2026 02:00 +0000"), "Etc/UTC", true, 1320, 120), "end exclusive")
    ms_assert(ms_session(timestamp("01 Jan 2026 12:00 +0000"), "Etc/UTC", true, 0, 0), "equal bounds all day")
    array<float> boundaryPrices = array.new_float(2, na)
    array<int> boundaryTimes = array.new_int(2, na)
    [bn, bc, bm, br, ba, breset] = ms_window(boundaryPrices, boundaryTimes, 0, 0, 1.10000, 0, 2, 0.0001, 5000, 0)
    [bn2, bc2, bm2, br2, ba2, breset2] = ms_window(boundaryPrices, boundaryTimes, bn, bc, 1.10015, 1000, 2, 0.0001, 5000, 0)
    ms_assert(bm2 == 1.5, "exact EURUSD threshold despite floating subtraction")
    ms_assert(ms_ticks(5, 0.0001, 0.00001) == 50 and ms_ticks(0.1, 0.0001, 0.0001) == 1, "stop ticks and minimum")
    array<float> prices = array.new_float(4, na)
    array<int> stamps = array.new_int(4, na)
    int next = 0
    int count = 0
    for i = 0 to 4
        [n, c, momentum, priceRange, active, reset] = ms_window(prices, stamps, next, count, float(i + 1), i * 1000, 3, 1.0, 5000, 0)
        next := n
        count := c
        ms_assert(i < 2 ? na(momentum) : momentum == 2, "warmup/momentum")
        if i >= 2
            ms_assert(priceRange == 2, "window range")
        ms_assert(reset == 0, "continuous samples")
    ms_assert(next == 1 and count == 4, "ring wrap")
    [jn, jc, jm, jr, ja, jreset] = ms_window(prices, stamps, next, count, 10, 5000, 3, 1.0, 5000, 1)
    ms_assert(jreset == 2 and jc == 0 and na(jm), "jump rejected, buffer empty")
    [sn, sc, sm, sr, sa, sreset] = ms_window(prices, stamps, jn, jc, 10, 6000, 3, 1.0, 5000, 1)
    ms_assert(sc == 1 and na(sm), "recover after jump")
    [gn, gc, gm, gr, ga, greset] = ms_window(prices, stamps, sn, sc, 10, 20000, 3, 1.0, 5000, 1)
    ms_assert(greset == 1 and gc == 1 and na(gm), "gap seeds new window")
    [an, ac, am, ar, aa, areset] = ms_window(prices, stamps, gn, gc, 10, 82000, 3, 1.0, 120000, 1)
    ms_assert(aa == 1, "old activity expires")
    [tn, tc, tm, tr, ta, treset] = ms_window(prices, stamps, an, ac, 10, 81000, 3, 1.0, 120000, 1)
    ms_assert(treset == 1 and tc == 1, "clock reversal reset")
    [l1, d1] = ms_episode(2, 2, 0, true)
    [l2, d2] = ms_episode(3, 2, l1, true)
    [l3, d3] = ms_episode(1, 2, l2, true)
    [l4, d4] = ms_episode(0.9, 2, l3, true)
    [l5, d5] = ms_episode(-2, 2, l4, true)
    [l6, d6] = ms_episode(2, 2, l5, true)
    ms_assert(d1 == 1 and d2 == 0 and l3 == 1 and l4 == 0 and d5 == -1 and d6 == 1, "episodes/rearming/reversal")
    [blockedLatch, blockedDirection] = ms_episode(-3, 2, l6, false)
    ms_assert(blockedLatch == l6 and blockedDirection == 0, "filter blocks episode")
    ms_assert(ms_cooldown(1000, 1000, 30) == 30, "same-update cooldown display")
    ms_assert(ms_cooldown(30999, 1000, 30) == 1, "cooldown not yet elapsed")
    ms_assert(ms_cooldown(31000, 1000, 30) == 0 and ms_cooldown(0, int(na), 30) == 0, "cooldown boundary")
    ms_assert(ms_can_signal(1, 31000, 1000, 30, 0, 1), "eligible before cap")
    ms_assert(not ms_can_signal(1, 31000, 1000, 30, 1, 1), "cap immediately blocks")
    ms_assert(not ms_can_signal(1, 30999, 1000, 30, 0, 1), "cooldown gate")
    ms_assert(not ms_can_signal(0, 31000, 1000, 30, 0, 1), "no candidate no event")
    [qty, allowed] = ms_quantity(10, 0.0005, 1000, 1000, 1000000)
    ms_assert(allowed and qty == 20000, "risk-based sizing")
    [small, smallAllowed] = ms_quantity(0.1, 0.0005, 1000, 1000, 1000000)
    ms_assert(not smallAllowed, "minimum quantity rejected")
    [capped, cappedAllowed] = ms_quantity(100, 0.0005, 1000, 1000, 15500)
    ms_assert(cappedAllowed and capped == 15000, "cap rounded down")
    [bad, badAllowed] = ms_quantity(10, float(na), 1000, 1000, 1000000)
    ms_assert(not badAllowed, "missing currency conversion rejected")
    [b1, p1, k1] = ms_daily(true, 10000, 9850, 10000, 9000, false, 1)
    ms_assert(b1 == 10000 and math.abs(p1 + 1.5) < 0.00001 and k1, "first-bar loss counted")
    [b2, p2, k2] = ms_daily(false, 9850, 10100, 10000, b1, k1, 1)
    ms_assert(k2 and b2 == b1, "daily lock survives recovery")
    [b3, p3, k3] = ms_daily(true, 10100, 10100, 10000, b2, k2, 1)
    ms_assert(not k3 and p3 == 0, "next-day reset")
    table.cell(result, 0, 0, "Core helper assertions PASSED (not live execution validation)", text_color=color.white, bgcolor=color.green)
plot(float(na), display=display.none)
